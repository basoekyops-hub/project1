        "provinsi": { "type": "string" },
        "foto": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "mapsUrl": { "type": "string" },
        "kepalaSekolahNama": { "type": "string" },
        "jumlahGuru": { "type": "number" },
        "jumlahSiswa": { "type": "number" },
