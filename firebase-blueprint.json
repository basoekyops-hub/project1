  "firestore": {
    "/pengawas/{pengawasId}": {
      "schema": "Pengawas",
      "description": "Profil pengawas sekolah"
    },
    "/pengaturanWebsite/{settingId}": {
      "schema": "PengaturanWebsite",
      "description": "Pengaturan identitas website"
    },
    "/sekolah/{sekolahId}": {
      "schema": "Sekolah",
      "description": "Daftar sekolah binaan"
    },
    "/visiMisi/{id}": {
      "schema": "VisiMisi",
      "description": "Visi misi sekolah"
    },
    "/strukturOrganisasi/{id}": {
      "schema": "StrukturOrganisasi",
      "description": "Struktur organisasi sekolah"
    },
    "/fasilitas/{id}": {
      "schema": "Fasilitas",
      "description": "Fasilitas sekolah"
    },
    "/keunggulan/{id}": {
      "schema": "Keunggulan",
      "description": "Keunggulan sekolah"
    },
    "/kepalaSekolah/{id}": {
      "schema": "KepalaSekolah",
      "description": "Kepala sekolah"
    },
    "/guru/{id}": {
      "schema": "Guru",
      "description": "Guru dan tenaga kependidikan"
    },
    "/prestasi/{id}": {
      "schema": "Prestasi",
      "description": "Prestasi sekolah dan murid"
    },
    "/berita/{id}": {
      "schema": "Berita",
      "description": "Berita dan warta kegiatan"
    },
    "/pengumuman/{id}": {
      "schema": "Pengumuman",
      "description": "Pengumuman resmi"
    },
    "/galeri/{id}": {
      "schema": "Galeri",
      "description": "Galeri media foto dan video"
    },
    "/kontak/{id}": {
      "schema": "Kontak",
      "description": "Pesan kontak masuk"
    }
  }
}
