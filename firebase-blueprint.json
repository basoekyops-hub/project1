        "alamat": { "type": "string" },
        "logo": { "type": "string" },
        "favicon": { "type": "string" },
        "deskripsi": { "type": "string" },
        "footer": { "type": "string" },
        "facebook": { "type": "string" },
        "instagram": { "type": "string" },
        "youtube": { "type": "string" },
        "tiktok": { "type": "string" },
