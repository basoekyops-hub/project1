{
  "entities": {
    "Pengawas": {
      "title": "Pengawas",
      "description": "Profil resmi pengawas sekolah pembina",
      "type": "object",
      "properties": {
        "nama": { "type": "string" },
        "gelar": { "type": "string" },
        "nip": { "type": "string" },
        "pangkatGolongan": { "type": "string" },
        "jabatan": { "type": "string" },
        "wilayahKerja": { "type": "string" },
        "kecamatan": { "type": "string" },
        "kabupaten": { "type": "string" },
        "provinsi": { "type": "string" },
