        "tanggal": { "type": "string" }
      },
      "required": ["judul", "url", "kategori"]
    },
    "Kontak": {
      "title": "Kontak",
      "description": "Pesan konsultasi dan pertanyaan dari masyarakat/sekolah",
      "type": "object",
      "properties": {
        "nama": { "type": "string" },
        "email": { "type": "string" },
        "telepon": { "type": "string" },
        "subjek": { "type": "string" },
        "pesan": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["nama", "email", "subjek", "pesan"]
    }
