    "PengaturanWebsite": {
      "title": "PengaturanWebsite",
      "description": "Identitas dinamis website dan konfigurasi kontak pengawas",
      "type": "object",
      "properties": {
        "namaPortal": { "type": "string" },
        "subjudul": { "type": "string" },
        "namaPengawas": { "type": "string" },
        "fotoPengawas": { "type": "string" },
        "nipPengawas": { "type": "string" },
        "jabatan": { "type": "string" },
        "jenjang": { "type": "string" },
        "kecamatan": { "type": "string" },
        "kabupaten": { "type": "string" },
        "provinsi": { "type": "string" },
        "email": { "type": "string" },
        "telepon": { "type": "string" },
