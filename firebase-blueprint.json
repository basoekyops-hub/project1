        "keterangan": { "type": "string" },
        "sambutan": { "type": "string" }
      },
      "required": ["sekolahId", "nama"]
    },
    "Guru": {
      "title": "Guru",
      "description": "Data dewan pendidik dan tenaga kependidikan",
